{
    "name": "antonioprimera/efc",
    "description": "efc",
    "authors": [
        {
            "name": "Antonio Primera",
            "email": "antonio@cus.ro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-simplexml": "*",
        "antonioprimera/cif": "^1.0",
        "antonioprimera/filesystem": "^2.2.3",
        "spatie/laravel-data": "^4.13",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": ">=8.22.0",
        "pestphp/pest": ">=2.35.1",
        "pestphp/pest-plugin-arch": ">=v2.7.0",
        "pestphp/pest-plugin-laravel": ">=v2.4.0",
        "spatie/laravel-ray": "^1.37.1"
    },
    "autoload": {
        "psr-4": {
            "AntonioPrimera\\Efc\\": "src/",
            "AntonioPrimera\\Efc\\Tests\\": "tests/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AntonioPrimera\\Efc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AntonioPrimera\\Efc\\EfcServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "proprietary"
}
